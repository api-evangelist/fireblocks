            "params": [
              {
                "name": "cosignerId",
                "value": "44fcead0-7053-4831-a53a-df7fb90d440f",
                "type": "path",
                "description": "The unique identifier of the cosigner"
              }
            ]
          },
          "docs": "Get a cosigner by ID.\n**Note:** These endpoints are currently in beta and might be subject to changes.\n</br>Endpoint Permission: Admin and Non-Signing Admin."
        },
