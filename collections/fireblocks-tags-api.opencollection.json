{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fireblocks Blockchains and Assets Approval Requests Tags API",
    "version": "1.8.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fireblocks.io/v1/tags",
            "params": [
              {
                "name": "pageCursor",
                "value": "MjAyMy0xMi0xMyAyMDozNjowOC4zMDI=:MTEwMA==",
                "type": "query",
                "description": "Page cursor to get the next page."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of items in the page"
              },
              {
                "name": "label",
                "value": "VIP",
                "type": "query",
                "description": "Label prefix to filter by."
              },
              {
                "name": "tagIds",
                "value": "",
                "type": "query",
                "description": "List of tag IDs to filter by."
              },
              {
                "name": "includePendingApprovalsInfo",
                "value": "",
                "type": "query",
                "description": "Include pending approval information for each tag"
              }
            ]
          },
          "docs": "Retrieve a paged list of all tags according to filters."
        },
        {
          "info": {
            "name": "Create a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fireblocks.io/v1/tags",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new tag.\n\n**Endpoint Permissions:**\n- For protected tags: Owner, Admin, Non-Signing Admin.\n- For non-protected tags: Owner, Admin, Non-Signing Admin, Signer, Editor, Approver.\n"
        },
        {
          "info": {
            "name": "Get a tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fireblocks.io/v1/tags/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The ID of the tag to retrieve"
              }
            ]
          },
          "docs": "Retrieve an existing tag by ID."
        },
        {
          "info": {
            "name": "Update a tag",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.fireblocks.io/v1/tags/:tagId",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The ID of the tag to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing specified tag.\n\n**Endpoint Permissions:**\n- For protected tags: Owner, Admin, Non-Signing Admin.\n- For non-protected tags: Owner, Admin, Non-Signing Admin, Signer, Editor, Approver.\n"
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.fireblocks.io/v1/tags/:tagId",
            "params": [
              {
                "name": "tagId",
                "value": "",
                "type": "path",
                "description": "The ID of the tag to retrieve"
              }
            ]
          },
          "docs": "Delete the specified tag.\n\n**Endpoint Permissions:**\n- For protected tags: Owner, Admin, Non-Signing Admin.\n- For non-protected tags: Owner, Admin, Non-Signing Admin, Signer, Editor, Approver.\n"
        }
      ]
    }
  ],
  "bundled": true
}