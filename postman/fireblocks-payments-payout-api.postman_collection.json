                      "cookie": [],
                      "responseTime": null,
                      "body": "{\n  \"payoutId\": \"<string>\",\n  \"createdAt\": \"<number>\",\n  \"state\": \"FILE_FOUND\",\n  \"status\": \"IN_PROGRESS\",\n  \"paymentAccount\": {\n    \"id\": \"<string>\",\n    \"type\": \"FIAT_ACCOUNT\"\n  },\n  \"instructionSet\": [\n    {\n      \"amount\": {\n        \"amount\": \"<string>\",\n        \"assetId\": \"<string>\"\n      },\n      \"payeeAccount\": {\n        \"id\": \"<string>\",\n        \"type\": \"VAULT_ACCOUNT\"\n      },\n      \"state\": \"FAILED\",\n      \"transactions\": [\n        {\n          \"id\": \"<string>\",\n          \"state\": \"CONFIRMED\",\n          \"timestamp\": \"<number>\",\n          \"instructionId\": \"<string>\"\n        },\n        {\n          \"id\": \"<string>\",\n          \"state\": \"CONFIRMING\",\n          \"timestamp\": \"<number>\",\n          \"instructionId\": \"<string>\"\n        }\n      ],\n      \"id\": \"<string>\"\n    },\n    {\n      \"amount\": {\n        \"amount\": \"<string>\",\n        \"assetId\": \"<string>\"\n      },\n      \"payeeAccount\": {\n        \"id\": \"<string>\",\n        \"type\": \"NETWORK_CONNECTION\"\n      },\n      \"state\": \"TRANSACTION_SENT\",\n      \"transactions\": [\n        {\n          \"id\": \"<string>\",\n          \"state\": \"PENDING_SIGNATURE\",\n          \"timestamp\": \"<number>\",\n          \"instructionId\": \"<string>\"\n        },\n        {\n          \"id\": \"<string>\",\n          \"state\": \"COMPLETED\",\n          \"timestamp\": \"<number>\",\n          \"instructionId\": \"<string>\"\n        }\n      ],\n      \"id\": \"<string>\"\n    }\n  ],\n  \"reasonOfFailure\": \"<string>\",\n  \"initMethod\": \"FILE\",\n  \"reportUrl\": \"<string>\"\n}",
